# Copy to .env.local for local development. Every variable is optional;
# with none of them set, Yesbird runs fully on the local filesystem and
# prints "they said yes" notifications to the server console.

# --- Email to the asker when their person says yes (pick ONE path) ---------

# Path A: Resend (https://resend.com). Recommended; ~5 minutes to set up.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender shown in the inbox. Must be a domain verified in Resend, or use the
# sandbox sender "Yesbird <onboarding@resend.dev>" (only delivers to your own address).
# EMAIL_FROM="Yesbird <hello@yourdomain.com>"

# Path B: any webhook (Zapier, Make, n8n, your own endpoint). Receives the
# JSON payload described in docs/HANDOFF.md. Used only when RESEND_API_KEY is unset.
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/yesbird

# --- Storage --------------------------------------------------------------

# Local / single-server hosting: where invitation JSON files are written.
# YESBIRD_DATA_DIR=./data/invites

# Serverless hosting (Vercel, Netlify…): use Upstash Redis instead of files.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# --- Misc -----------------------------------------------------------------

# Public URL of the deployed site, used for links inside emails.
# Falls back to the request's host header when unset.
# NEXT_PUBLIC_APP_URL=https://yesbird.example.com

# Tip jar link shown to askers (never to the person being asked).
# NEXT_PUBLIC_TIP_URL=https://buymeacoffee.com/xfreeze
